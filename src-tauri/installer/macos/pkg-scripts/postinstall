#!/bin/sh
# Run by the installer, as root, once Arnold.app is in place ($2 is the folder it went into):
# makes the `arnold` and `ace` commands available in a terminal.
set -eu

mkdir -p /usr/local/bin
for name in arnold ace; do
  ln -sfh "$2/Arnold.app/Contents/Resources/bin/arnold" "/usr/local/bin/$name"
done
