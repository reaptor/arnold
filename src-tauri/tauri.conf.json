{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arnold",
  "version": "0.1.0",
  "identifier": "app.arnold.review",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arnold",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 480,
        "visible": false,
        "create": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 22 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2Q0UyQ0QwRDMzQzJEOTkKUldTWkxUelQwQ3pPdGgySGFFWWJvYWNQQ2QxRnlGYlpubzVMd1luNG1wVnQzdzk2UzNaR1U4TGQK",
      "endpoints": [
        "https://github.com/reaptor/arnold/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
